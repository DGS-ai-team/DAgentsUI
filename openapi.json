{
  "openapi": "3.1.0",
  "info": {
    "title": "DAgents API",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Prometheus Metrics",
        "operationId": "prometheus_metrics_metrics_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/v1/sessions": {
      "post": {
        "summary": "Create Session",
        "operationId": "create_session_v1_sessions_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SessionCreateIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionCreateResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/sessions/{session_id}/cancel": {
      "post": {
        "summary": "Cancel Current Turn",
        "description": "取消指定 session 当前正在执行的 `_handle_message`（流式输出会中断，上下文由 runtime `flush_cancelled_turn` 修补）。",
        "operationId": "cancel_current_turn_v1_sessions__session_id__cancel_post",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Session Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CancelTurnResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/sessions/{session_id}": {
      "delete": {
        "summary": "Release Session",
        "description": "释放指定 session 的服务端资源，并删除该会话持久化记录。",
        "operationId": "release_session_v1_sessions__session_id__delete",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Session Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionReleaseResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/messages": {
      "post": {
        "summary": "Submit Message",
        "operationId": "submit_message_v1_messages_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MessageIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/streams": {
      "get": {
        "summary": "Stream All",
        "description": "订阅全局 SSE 流（跨 session/request 的实时事件）。\n\n逻辑：\n1. 连接建立后持续读取事件总线 `subscribe_all()`；\n2. 每条事件均透传为标准 SSE 包；\n3. 连接断开由客户端主动关闭或网络中断触发。\n\n关键边界：\n- 该接口仅推送连接建立后的实时事件，不回放历史；\n- 同一前端可复用一个连接并按 `session_id` 在本地分流展示。",
        "operationId": "stream_all_v1_streams_get",
        "parameters": [
          {
            "name": "client_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Client Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CancelTurnResult": {
        "properties": {
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "cancelled": {
            "type": "boolean",
            "title": "Cancelled"
          }
        },
        "type": "object",
        "required": [
          "session_id",
          "cancelled"
        ],
        "title": "CancelTurnResult",
        "description": "取消当前推理 turn 的响应（无在途任务时 `cancelled=false`）。"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MessageIn": {
        "properties": {
          "session_id": {
            "type": "string",
            "minLength": 1,
            "title": "Session Id"
          },
          "client_id": {
            "type": "string",
            "minLength": 1,
            "title": "Client Id",
            "default": "default"
          },
          "request_type": {
            "type": "string",
            "enum": [
              "message",
              "resume"
            ],
            "title": "Request Type",
            "default": "message"
          },
          "content": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Content"
          },
          "resume_value": {
            "anyOf": [
              {},
              {
                "type": "null"
              }
            ],
            "title": "Resume Value"
          },
          "source": {
            "type": "string",
            "title": "Source",
            "default": "api"
          },
          "priority": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "tool_result",
                  "human",
                  "resume",
                  "other"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Priority"
          }
        },
        "type": "object",
        "required": [
          "session_id"
        ],
        "title": "MessageIn"
      },
      "SessionCreateIn": {
        "properties": {
          "session_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id"
          }
        },
        "type": "object",
        "title": "SessionCreateIn"
      },
      "SessionCreateResult": {
        "properties": {
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "created": {
            "type": "boolean",
            "title": "Created"
          }
        },
        "type": "object",
        "required": [
          "session_id",
          "created"
        ],
        "title": "SessionCreateResult"
      },
      "SessionReleaseResult": {
        "properties": {
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "released": {
            "type": "boolean",
            "title": "Released"
          }
        },
        "type": "object",
        "required": [
          "session_id",
          "released"
        ],
        "title": "SessionReleaseResult"
      },
      "SubmitResult": {
        "properties": {
          "accepted": {
            "type": "boolean",
            "title": "Accepted"
          },
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "priority": {
            "type": "string",
            "enum": [
              "tool_result",
              "human",
              "resume",
              "other"
            ],
            "title": "Priority"
          }
        },
        "type": "object",
        "required": [
          "accepted",
          "session_id",
          "priority"
        ],
        "title": "SubmitResult"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}